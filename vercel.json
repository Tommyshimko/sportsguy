{
  "rewrites": [
    {
      "source": "/",
      "destination": "/app/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/warm-season",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hd/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
